\ifbool{showsectiontoc}{
  \AtBeginSection[]
  {
      \begingroup
      \begin{frame}{Table of Contents}{}
      \leftskip=3em
      \tableofcontents[
        currentsection,
        sectionstyle=show/hide,
        subsectionstyle=show/show/hide
      ]
      \end{frame}
      \endgroup
  }
}{}  % 若为 false，则什么都不安装

