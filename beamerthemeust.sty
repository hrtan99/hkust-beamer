% --- 控制 titlepage 背景模式 ---
% modes: solid (default), splitfade, none
\newcommand{\titlebgstyle}{solid}

\newcommand{\settitlebg}[1]{%
  \renewcommand{\titlebgstyle}{#1}%
}

\settitlebg{trapezoid}      % 梯形背景
% \settitlebg{solid}      % 纯色梯形
% \settitlebg{splitfade} % 左实右渐隐
% \settitlebg{none}      % 不绘制背景

% 设定梯形上/下边宽度（用 paperwidth 更稳，不受左右 margin 影响）
\newlength{\TrapTop}\setlength{\TrapTop}{.8\paperwidth}  % 上边 0.7 × 页面宽
\newlength{\TrapBot}\setlength{\TrapBot}{.2\paperwidth}  % 下边 0.4 × 页面宽
\newlength{\TrapRight}\setlength{\TrapRight}{.3\paperheight}  % 右边 0.7 × 页面宽

\newcommand{\TPTrapezoid}{%
  \fill[\@BgColor,
    draw=\@BgColor!50!ustblue,
    line width=.0pt,
    opacity=1]
    (current page.south west) --
    ([xshift=\TrapBot]current page.south west) ..
    controls ++ (5cm,0cm) and ++ (0cm,-5cm) ..
    ([xshift=\TrapTop]current page.north west) --
    (current page.north west) -- cycle;
}

% --- 背景：纯色梯形 ---
\newcommand{\TPBGsolid}{%
  \fill[\@BgColor, draw=\@BgColor!50!ustblue, line width=.0pt, opacity=1]
    (current page.south west) --
    ([xshift=\TrapBot]current page.south west) ..
    controls ++ (10cm,0cm) and ++ (-8cm,1cm) ..
    (current page.north east) --
    (current page.north west) -- cycle;
}

% 渐变快、距离短：fade right short
\tikzfading[name=fade right short,
  left color=transparent!0,
  middle color=transparent!0,         % 中段仍不透明
  right color=transparent!100,
  fading angle=0,         % 0° 表示水平方向
  % 控制距离短（默认缩放）
  fading transform={xscale=2}
]

% 渐变慢、距离长：fade right long
\tikzfading[name=fade right long,
  left color=transparent!0,
  right color=transparent!50,
  fading angle=0,         % 0° 表示水平方向
  % 控制距离长
  fading transform={xscale=2}
]


% --- 背景：左实图形 + 右渐隐 ---
\newcommand{\TPBGsplitfade}{%
  % 左侧矩形
  \fill[\@BgColor, draw=\@BgColor, line width=.0pt, opacity=1]
  (current page.south west) rectangle
  ([xshift=\TrapBot]current page.north west);
  % 右侧渐隐
  \fill[
    fill=\@BgColor,
    draw=\@BgColor,
    line width=.0pt,
    opacity=1,
    path fading=fade right short
  ]
  ([xshift=\TrapBot]current page.south west) rectangle
  ([xshift=\TrapTop]current page.north west);
}

% --- 背景：不画任何背景 ---
\newcommand{\TPBGnone}{}

% Define the title page
\setbeamertemplate{title page}{%
  % \vskip0pt plus 1filll%
  \vspace*{.5cm}
  \begin{tikzpicture}[remember picture,overlay]
    \ifdefstring{\titlebgstyle}{trapezoid}{\TPTrapezoid}{}
    \ifdefstring{\titlebgstyle}{solid}{\TPBGsolid}{}
    \ifdefstring{\titlebgstyle}{splitfade}{\TPBGsplitfade}{}
    \ifdefstring{\titlebgstyle}{none}{\TPBGnone}{}
    
    % 2. draw the content area
    \begin{scope}
      \clip
        (current page.south west) --
        ([xshift=\TrapBot]current page.south west) ..
        controls ++ (5cm,0cm) and ++ (0cm,-5cm) ..
        ([xshift=\TrapTop]current page.north west) --
        (current page.north west) -- cycle;

      % 内容区：靠左上放一个竖向排版的 minipage
      \node[anchor=north west, inner sep=.6cm]
        at ([yshift=-20mm]current page.north west) {%
          \begin{minipage}[t]{.6\paperwidth} % 内容宽度略小于上边宽，避免贴边
            \vspace{1em}
            {\usebeamerfont{title}\color{ustblue}\inserttitle\par}
            \vspace{1em}
            {\usebeamerfont{subtitle}\color{ustblue!80}\insertsubtitle\par}
            \vspace{1.5em}
            {\usebeamerfont{author}\insertauthor\par}
            \vspace{0.4em}
            {\usebeamerfont{institute}\insertinstitute\par}
            \vspace{0.4em}
            {\usebeamerfont{date}\insertdate\par}
          \end{minipage}%
        };
    \end{scope}

    \fill[ustblue] (current page.south west) rectangle ++(0.1cm,\paperheight);
    \end{tikzpicture}

    % Add the logo to the top left corner of the title page
    \begin{tikzpicture}[remember picture,overlay]
    \node[anchor=north west, xshift=0.55cm, yshift=-0.5cm] (logo) at (current page.north west) {
      \includegraphics[width=3.8cm]{images/ust_std.pdf}
    };
    % 可选会议 Logo
    \ifbool{showconflogo}{%
      \node[anchor=north west, xshift=5cm, yshift=-0.5cm] at (current page.north west) {
        \includegraphics[height=1cm]{\@ConfLogoFile}
      };
    }{}
    \draw[ustblue, line width=.5pt]
      ($(logo.south west)+(1mm,-1mm)$) -- ($(logo.south east)+(-1mm,-1mm)$);
    \end{tikzpicture}
}


\newcommand{\TikzSplitSlide}[1]{%
  \rule{0.4\paperwidth}{0pt}%
  \begin{tikzpicture}
    \clip (-0.1\paperwidth,-0.5\paperheight) -- 
          ( 0.5\paperwidth,-0.5\paperheight) -- 
          ( 0.5\paperwidth, 0.5\paperheight) -- 
          ( 0.1\paperwidth, 0.5\paperheight) -- cycle; 
    \node at (0.2\paperwidth,0) {%
      \includegraphics[height=\paperheight]{#1}%
    };
  \end{tikzpicture}
}

\newbool{splittitle}
\newcommand{\@TitleBackground}{}
\newcommand{\titlebackground}{\@ifstar{\SplitBackground}{\FullBackground}}
\newcommand{\FullBackground}[1]{\renewcommand{\@TitleBackground}{#1}}
\newcommand{\SplitBackground}[1]{%
	\booltrue{splittitle}%
	\renewcommand{\@TitleBackground}{#1}%
}

\renewcommand{\maketitle}{
\begingroup
  \usebackgroundtemplate{
    \begin{tikzpicture}[remember picture,overlay]
    \node[anchor=south west,inner sep=0, xshift=24mm] at (current page.south west) {%
    \includegraphics[
      height=\paperheight,
      keepaspectratio,
      trim=0mm 0mm 0mm 0mm,
      clip
      ]{\@TitleBackground}
    };
    \end{tikzpicture}
  }
  \begin{frame}[plain]%
  \titlepage%
  \end{frame}%
  \usebackgroundtemplate{}
  \ifdefempty{\@TitleBackground}{}{% Skip if \@TitleBackground is empty
    \setbeamertemplate{background}{%
      \ifbool{splittitle}{%
        \TikzSplitSlide{\@TitleBackground}
      }{% Normal, full-screen background
        \includegraphics[width=\paperwidth]{\@TitleBackground}
        % \includegraphics[height=\paperheight]{\@TitleBackground}
      }
    }
  }
\endgroup
}


