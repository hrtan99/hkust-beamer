% 设置左侧 sidebar，宽度约 1.2cm
\setbeamersize{sidebar width left=.0cm}
\setbeamertemplate{sidebar left}{%
  \begin{tikzpicture}[remember picture,overlay]
    % 页码节点：锚在左上，距离顶部 5mm
    \node[anchor=south west, xshift=3pt, yshift=20mm] at (current page.south west) {%
      \rotatebox{90}{\usebeamerfont{footline}\hfill\@footlinepayoff}%
    };
    % 导航符号节点：锚在左下，距离底部 5mm
